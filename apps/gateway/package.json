{
  "name": "@open-agents/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --env-file=.env --import tsx/esm --watch src/dev.ts",
    "start": "node dist/dev.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo 'no-op'"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@open-agents/crypto": "workspace:*",
    "@open-agents/db": "workspace:*",
    "hono": "^4.6.9",
    "viem": "^2.48.8",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@noble/curves": "^1.6.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.0",
    "vitest": "^2.1.4"
  }
}
